{
  "name": "stackqueue-server",
  "version": "1.0.0",
  "description": "STACK QUEUE — Inclusive Learning Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node daemon.js",
    "start:daemon": "node daemon.js",
    "start:direct": "node server.js",
