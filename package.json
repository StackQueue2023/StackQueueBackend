    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2"
  }
}
